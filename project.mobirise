              },
              "@media (max-width: 991px)": {
                "padding": "20px"
              },
              "@media (max-width: 767px)": {
                "padding": "12px"
              }
            },
            ".item-title": {
              "position": "relative",
              "width": "100%",
              "color": "#e3ebf3"
            },
            ".mbr-section-btn": {
              "position": "relative",
              "width": "100%",
              "transform": "translateX(50%)",
              "opacity": "0",
              "transition": ".5s",
              ".btn": {
                "min-width": "200px !important",
