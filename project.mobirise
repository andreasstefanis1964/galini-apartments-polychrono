            },
            ".mbr-section-subtitle": {
              "margin-top": "20px",
              "color": "#e3ebf3"
            },
            ".row": {
              "display": "flex",
              "align-items": "stretch",
              "gap": "20px",
              "@media (max-width: 767px)": {
                "gap": "12px"
              }
            },
            ".item-wrap": {
              "position": "relative",
              "display": "flex",
              "flex-direction": "column",
              "justify-content": "space-between",
              "height": "100%",
              "padding": "50px",
              "@media (max-width: 1399px)": {
