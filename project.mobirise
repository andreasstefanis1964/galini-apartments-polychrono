              }
            },
            ".item-wrapper": {
              "display": "flex",
              "align-items": "flex-start",
              "gap": "20px",
              "padding": "32px",
              "& when (@showBorder)": {
                "border": "1px solid @borderColor",
                "border-radius": "20px"
              },
              "& when (@reverseContent)": {
                "flex-direction": "row-reverse"
              },
              "@media (max-width: 1399px)": {
