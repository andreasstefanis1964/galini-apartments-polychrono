              },
              "@media (max-width: 1199px)": {
                "& when (@showBorder)": {
                  "border-radius": "12px"
                }
              },
              "@media (max-width: 767px)": {
                "gap": "40px",
                "flex-wrap": "wrap",
                "padding": "12px",
                "& when (@showBorder)": {
                  "border-radius": "12px"
                }
              },
              "@media (min-width: 992px)": {
                "&:hover": {
                  ".image-wrapper": {
                    "img": {
                      "transform": "scale(1.1)"
                    }
                  }
                }
              }
            },
            ".col-text": {
              "display": "flex",
              "align-items": "flex-start",
              "width": "~\"calc(50% - 10px)\"",
              "@media (max-width: 1199px)": {
                "width": "100%",
                "order": "1"
              },
              "@media (max-width: 767px)": {
                "width": "100%"
              }
            },
            ".date-wrap": {
              "display": "flex",
              "align-items": "flex-start",
              "gap": "20px",
              "margin-bottom": "10px"
            },
            ".day-text": {
              "color": "#e3ebf3"
            },
            ".month-text": {
              "color": "#e3ebf3"
            },
            ".year-text": {
              "color": "#e3ebf3"
            },
            ".card-title": {
              "color": "#8e97a1"
            },
            ".mbr-text": {
              "margin-top": "12px",
              "color": "#e3ebf3"
            },
            ".mbr-section-btn": {
              "margin-top": "16px",
              "@media (max-width: 767px)": {
                "margin-top": "12px"
              }
            },
            ".col-img": {
              "width": "~\"calc(50% - 10px)\"",
              "@media (max-width: 1199px)": {
                "width": "100%",
                "order": "2"
              },
              "@media (max-width: 767px)": {
