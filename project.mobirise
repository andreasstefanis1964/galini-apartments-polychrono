          "_name": "afeatures1",
          "_sourceTheme": "homem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features1 homem5\" group=\"Features\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"1\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" name=\"showTitle\" title=\"Title\">\n        <input type=\"checkbox\" name=\"showSubtitle\" title=\"Subtitle\">\n        <header>Cards</header>\n        <select title=\"Count\" name=\"cardsCount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\" selected>2</option>\n        </select>\n        <input type=\"range\" name=\"imageHeight\" title=\"Height\" min=\"1\" max=\"6\" step=\"1\" value=\"4\">\n        <input type=\"checkbox\" name=\"showCardTitle\" title=\"Title\" checked>\n        <input type=\"checkbox\" name=\"showText\" title=\"Text\" checked>\n        <input type=\"checkbox\" name=\"showButtons\" title=\"Buttons\" checked>\n        <input type=\"image\" title=\"Item 1 Bg\" name=\"item1Bg\" value=\"@PROJECT_PATH@/assets/images/wooden-bungalows-on-campsite-camping-2021-08-30-21-25-21-utc-copy-800x534.jpg\">\n        <input type=\"image\" title=\"Item 2 Bg\" name=\"item2Bg\" value=\"@PROJECT_PATH@/assets/images/a-small-complex-hotel-in-the-forest-consisting-of-2022-01-28-10-28-23-utc-copy-800x534.jpg\" condition=\"cardsCount > 1\">\n        <input type=\"color\" title=\"Item Overlay\" name=\"itemBgOverlay\" value=\"#000000\">\n        <input type=\"range\" inline title=\"Item Overlay Opacity\" name=\"itemBgOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.2\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" required>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#4b5158\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#1a1e21\" condition=\"overlay && bg.type == 'image'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay && bg.type == 'image'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"mbr-section-head\" mbr-if=\"showTitle || showSubtitle\">\n            <h4 class=\"mbr-section-title mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">\n                Vitae proin\n            </h4>\n            <h5 class=\"mbr-section-subtitle mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">\n                Quisque non tellus orci ac auctor augue mauris\n            </h5>\n        </div>\n\n        <div class=\"row\">\n\n            <div class=\"item border-item\">\n                <div class=\"item-wrap\">\n                    <h5 class=\"item-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-2\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">\n                        NULLA ALIQUET\n                    </h5>\n                    <div class=\"mbr-section-btn item-footer align-center mt-auto mb-auto\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-7\"><a class=\"btn btn-black item-btn\" target=\"_blank\" data-app-placeholder=\"Type Text\">Start Your<br>Journey</a></div>\n                    <p class=\"mbr-text mbr-fonts-style mt-1\" mbr-if=\"showText\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-text\">$ 250.00 / Night</p>\n                </div>\n            </div>\n\n            <div class=\"item border-item\" mbr-if=\"cardsCount > 1\">\n                <div class=\"item-wrap\">\n                    <h5 class=\"item-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-2\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">\n                        VIVERRA ORCI\n                    </h5>\n                    <div class=\"mbr-section-btn item-footer align-center mt-auto mb-auto\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-7\"><a class=\"btn btn-black item-btn\" target=\"_blank\" data-app-placeholder=\"Type Text\">Start Your\n<br>Journey</a></div>\n                    <p class=\"mbr-text mbr-fonts-style mt-1\" mbr-if=\"showText\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-text\">$ 550.00 / Night</p>\n                </div>\n            </div>\n\n        </div>\n    </div>\n</section>",
          "_cid": "ty7iImXjL2",
          "_anchor": "afeatures1-5",
          "_protectedParams": [],
          "_global": false,
